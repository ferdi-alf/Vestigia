# /public/models

# Variabel lingkungan
.env
.env.local
.env*.local

# Perkakas penulis, bukan bagian dari produk.
# Folder ini memuat repository git bersarang dan sekitar 12 MB berkas yang tidak
# dipakai satu baris pun oleh aplikasi. Membiarkannya ter-commit hanya
# menggemukkan repo. Perkakasnya tetap berfungsi penuh secara lokal.
/.claude/
